# --- COMPRESIÓN GZIP / DEFLATE ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# --- REGLAS DE CACHÉ DE NAVEGADOR (EXPIRES) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & PHP (No cachear para ver cambios dinámicos)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/x-httpd-php "access plus 0 seconds"

  # CSS y JavaScript (1 mes)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Imágenes (1 año)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fuentes web (1 año)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# --- ENCABEZADOS CACHE-CONTROL ---
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- REESCRITURA DE URLS Y REDIRECCIONES SEO LIMPIAS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Forzar HTTPS en todo el sitio (301 SEO + seguridad)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Redirigir /index o /index.php a la raíz / (301 SEO)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(index|index\.php)(\?[^\s]*)?\s [NC]
  RewriteRule ^ / [R=301,L]

  # 2. Redirigir peticiones externas directas con .php hacia la URL limpia (301 SEO)
  # Excluye la carpeta admin y peticiones POST
  RewriteCond %{REQUEST_URI} !^/admin [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php(\?[^\s]*)?\s [NC]
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^ /%1 [R=301,L]

  # 3. Quitar barra final (trailing slash) si no es un directorio real (ej: /nosotros/ -> /nosotros)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 4. Servir WebP automáticamente si existe y el cliente lo soporta
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+)\.(png|jpe?g)$ $1.webp [T=image/webp,L]

  # 5. Reescribir internamente la URL limpia hacia el archivo .php real
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)$ $1.php [L,QSA]
</IfModule>
